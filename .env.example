# Copy to .env.local and fill in

# App
APP_BASE_URL=http://localhost:3000

# Postgres (Supabase/Neon connection string)
DATABASE_URL=postgres://user:password@host:5432/apex

# Strava — from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match your Strava app's "Authorization Callback Domain"
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# WHOOP — from https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback

# Random long string used to sign the OAuth "state" param (CSRF protection)
OAUTH_STATE_SECRET=
